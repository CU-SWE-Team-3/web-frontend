# ─── Environment Variables ──────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
#
# For LOCAL development:
#   NEXTAUTH_URL should be http://localhost:5173 (matching the dev port)
#   NEXT_PUBLIC_API_URL should be /api (uses Next.js rewrite proxy to avoid CORS)
#
# For PRODUCTION deployment:
#   NEXTAUTH_URL should be https://biobeats.duckdns.org
#   NEXT_PUBLIC_API_URL should be https://biobeats.duckdns.org/api (same origin, no CORS)

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=biobeats_secure_secret_key_2026

# Use relative /api for local dev — proxied by next.config.js rewrites
NEXT_PUBLIC_API_URL=/api
